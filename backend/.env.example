# Copia este archivo a .env y ajusta si lo necesitas.

PORT=4000

# "vulnerable" activa los 6 fallos intencionales (Fase 2 de la guía).
# "patched" activa la versión corregida de cada uno (Fase 3 y 4).
# Puedes cambiarlo en caliente reiniciando el proceso; no requiere
# recompilar ni cambiar de rama.
SECURITY_MODE=vulnerable

# Secreto de firma JWT. En SECURITY_MODE=vulnerable, el endpoint de login
# además acepta tokens con alg:"none" (ver auth.routes.js), así que un
# secreto débil es parte intencional del escenario.
JWT_SECRET=fintrace-dev-secret-cambia-esto

# Origen permitido para el frontend (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Ruta del archivo SQLite
DB_PATH=./data/fintrace.db
